# LaunchMind environment template
# ------------------------------------------------------------
# Select one LLM provider: openai | groq | gemini
LLM_PROVIDER=groq

# OpenAI provider settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=

# Groq provider settings (OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini provider settings (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Retry behavior for transient LLM errors / rate limits
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=2

# ── GitHub ────────────────────────────────────────────────────────────────
# Personal Access Token with 'repo' and 'workflow' scopes
GITHUB_TOKEN=
# Format: owner/repo-name  e.g. johndoe/launchmind-groupname
GITHUB_REPO=

# ── Slack ─────────────────────────────────────────────────────────────────
# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=
# Public invite link used to auto-update README Slack workspace link after publish.
SLACK_WORKSPACE_INVITE_URL=

# ── Gmail API (optional) ──────────────────────────────────────────────────
# OAuth desktop client JSON downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_FILE=gmail_credentials.json
# Token file generated after first interactive OAuth run.
GMAIL_TOKEN_FILE=gmail_token.json
# Set true for first run to create token, then set false.
GMAIL_ALLOW_INTERACTIVE_OAUTH=false

# Sender and recipient used by Marketing Agent email task.
EMAIL_FROM=
EMAIL_TO=
