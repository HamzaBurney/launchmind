n      gap: 3rem 2.5rem;\n    }\n  }\n  @media(min-width: 900px) {\n    section.features {\n      grid-template-columns: repeat(3, 1fr);\n      gap: 3.5rem 2.5rem;\n    }\n  }\n  .feature {\n    background: var(--clr-white);\n    border-radius: var(--border-radius);\n    box-shadow: var(--shadow-light);\n    padding: 1.75rem 1.5rem 2rem;\n    transition: box-shadow 0.3s ease;\n  }\n  .feature:hover,\n  .feature:focus-within {\n    box-shadow: var(--shadow-hover);\n  }\n  .feature h3 {\n    margin-top: 0;\n    margin-bottom: 0.75rem;\n    font-weight: 600;\n    font-size: 1.25rem;\n    color: var(--clr-primary-dark);\n  }\n  .feature p {\n    margin: 0;\n    color: var(--clr-text-light);\n    font-size: 1rem;\n    line-height: 1.4;\n  }\n  .cta-container {\n    text-align: center;\n    margin-top: 4rem;\n  }\n  .btn-primary {\n    background: linear-gradient(135deg, var(--clr-gradient-start), var(--clr-gradient-end));\n    border: none;\n    color: var(--clr-white);\n    padding: 1rem 2.5rem;\n    font-size: 1.25rem;\n    font-weight: 700;\n    border-radius: 9999px;\n    cursor: pointer;\n    box-shadow: var(--shadow-light);\n    transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;\n    text-decoration: none;\n    display: inline-block;\n    user-select: none;\n  }\n  .btn-primary:hover,\n  .btn-primary:focus-visible {\n    background: linear-gradient(135deg, var(--clr-primary-dark), var(--clr-primary));\n    box-shadow: var(--shadow-hover);\n    outline: none;\n    transform: translateY(-2px);\n  }\n  footer {\n    background: #2d3748;\n    text-align: center;\n    padding: 1.5rem 1rem;\n    color: #a0aec0;\n    font-size: 0.9rem;\n    letter-spacing: 0.05em;\n  }\n</style>\n</head>\n<body>\n<header>\n  <h1>An Automated Platform That Streamlines Job Searching and Application Processes</h1>\n  <p>Use AI to find, customize, and submit relevant job opportunities efficiently, designed for every job seeker.</p>\n</header>\n<main>\n  <section class=\"features\" aria-label=\"Product Features\">\n    <article class=\"feature\" tabindex=\"0\">\n      <h3>Automated Job Matching Engine</h3>\n      <p>Uses AI to scan thousands of job boards and company postings to identify roles that match user skills, experience, and preferences.</p>\n    </article>\n    <article class=\"feature\" tabindex=\"0\">\n      <h3>Resume and Cover Letter Customization</h3>\n      <p>Automatically tailors resumes and cover letters based on each job description to improve application relevance and success.</p>\n    </article>\n    <article class=\"feature\" tabindex=\"0\">\n      <h3>One-Click Application Submission</h3>\n      <p>Allows users to submit applications directly through the platform to multiple job postings with minimal manual input.</p>\n    </article>\n    <article class=\"feature\" tabindex=\"0\">\n      <h3>Applicant Tracking Dashboard</h3>\n      <p>Provides users with real-time updates on application status, interview invites, and follow-up reminders.</p>\n    </article>\n    <article class=\"feature\" tabindex=\"0\">\n      <h3>Skill Gap Analysis & Recommendations</h3>\n      <p>Analyzes user profiles against desired roles, suggesting courses or certifications to enhance employability in target industries.</p>\n    </article>\n  </section>\n  <div class=\"cta-container\">\n    <a href=\"#\" class=\"btn-primary\" role=\"button\">Get Early Access</a>\n  </div>\n</main>\n<footer>\n  JobEase\n</footer>\n</body>\n</html>",
